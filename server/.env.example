# CareNova Backend Environment Variables (Render)
# Set these in Render Dashboard > Environment Variables

# Port for backend
PORT=5000

# Secure secret key for signing JWT tokens (use a long random string)
JWT_SECRET=carenova-super-secure-jwt-secret-2026

# Turso SQLite Hosted Database (From Turso Dashboard)
# Leave blank to use local SQLite file for development
TURSO_DATABASE_URL=libsql://carenova-db-yourusername.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token-here

# Real Conversational AI Integration (Google Gemini - Free Tier Available)
# Get your free key at: https://aistudio.google.com/
GEMINI_API_KEY=your-gemini-api-key-here

# Optional Alternative: OpenAI API Key
# OPENAI_API_KEY=your-openai-api-key-here
